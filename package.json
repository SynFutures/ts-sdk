{
    "name": "@synfutures/ts-sdk",
    "private": true,
    "version": "0.0.1",
    "description": "SynFutures TypeScript SDK monorepo",
    "author": "SynFutures",
    "license": "MIT",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.cjs",
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "deps": "pnpm -r i",
        "init": "./scripts/init.sh",
        "prepare": "husky",
        "lint": "eslint",
        "format": "pnpm -r run format",
        "clean": "pnpm -r clean",
        "release": "changeset publish",
        "release:dry": "changeset status"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.0",
        "husky": "^9.1.6",
        "lint-staged": "^16.4.0",
        "prettier": "^3.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.70.1"
    },
    "engines": {
        "node": ">=24 <25",
        "pnpm": ">=10 <11"
    },
    "pnpm": {
        "overrides": {
            "@derivation-tech/viem-kit": "file:./vendor/derivation-tech-viem-kit-d67d06d.tgz"
        }
    },
    "packageManager": "pnpm@10.34.5"
}
