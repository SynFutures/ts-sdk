{
    "name": "@synfutures/ts-sdk",
    "private": true,
    "version": "0.0.1",
    "description": "SynFutures TypeScript SDK monorepo",
    "author": "SynFutures",
    "license": "MIT",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.cjs",
        "nx": "nx run-many --target=build --all",
        "test": "nx run-many --target=test --all",
        "deps": "pnpm -r i",
        "init": "./scripts/init.sh",
        "prepare": "husky",
        "lint": "eslint",
        "format": "prettier --write packages/**/*.ts apps/**/*.ts",
        "clean": "pnpm -r clean",
        "release": "changeset publish",
        "release:dry": "changeset version && changeset publish --dry-run"
    },
    "devDependencies": {
        "@changesets/cli": "^2.28.1",
        "@eslint/js": "^9.9.1",
        "@nx/eslint": "20.0.6",
        "@nx/jest": "20.0.6",
        "eslint": "^9.7.0",
        "eslint-config-prettier": "^9.1.0",
        "husky": "^9.1.6",
        "lint-staged": "^16.2.3",
        "nx": "20.0.6",
        "prettier": "^3.3.3",
        "typescript": "^5.5.3",
        "typescript-eslint": "^8.3.0"
    },
    "engines": {
        "node": ">=18",
        "pnpm": ">=8"
    },
    "pnpm": {
        "peerDependencyRules": {
            "allowedVersions": {
                "eslint": "^9.2.0"
            }
        }
    }
}
