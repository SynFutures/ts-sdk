{
    "name": "@synfutures/ts-sdk",
    "private": true,
    "version": "0.0.1",
    "description": "SynFutures TypeScript SDK monorepo",
    "author": "SynFutures",
    "license": "MIT",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.cjs",
        "build": "pnpm -r run build",
        "test": "pnpm run verify:governance && pnpm --filter @synfutures/perpv3-ts run test",
        "deps": "pnpm -r i",
        "prepare": "husky",
        "lint": "oxlint --type-aware --deny-warnings .",
        "format": "prettier --write .",
        "clean": "pnpm -r clean",
        "release": "changeset publish",
        "release:dry": "changeset status",
        "format:check": "prettier --check .",
        "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts --no-frozen-lockfile",
        "test:release": "node --test scripts/tests/*.test.cjs",
        "build:governance": "pnpm --filter @synfutures/airdrop --filter \"@synfutures/*governance*\" run build",
        "test:plugin-types": "pnpm --filter @synfutures/oyster-governance exec tsc --noEmit --strict --skipLibCheck --target ES2020 --module commonjs ../../scripts/governance-plugin-types.ts test/host-types.ts",
        "verify:governance": "pnpm run build:governance && pnpm --filter @synfutures/airdrop --filter \"@synfutures/*governance*\" run test && pnpm run test:plugin-types && node --test scripts/plugin-runtime.test.cjs",
        "test:governance-consumers": "node scripts/verify-governance-consumers.cjs"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@types/node": "22.20.7",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "oxlint": "1.95.0",
        "oxlint-tsgolint": "7.0.2008",
        "prettier": "3.10.1",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=24 <25",
        "pnpm": ">=12 <13"
    },
    "packageManager": "pnpm@12.6.0"
}
