{
    "name": "@synfutures/ts-sdk",
    "private": true,
    "version": "0.0.1",
    "description": "SynFutures TypeScript SDK monorepo",
    "author": "SynFutures",
    "license": "MIT",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.cjs",
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "deps": "pnpm -r i",
        "init": "./scripts/init.sh",
        "prepare": "husky",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "clean": "pnpm -r clean",
        "release": "changeset publish",
        "release:dry": "changeset status",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "17.12.0",
        "husky": "^9.1.6",
        "lint-staged": "^16.4.0",
        "prettier": "3.6.2",
        "typescript": "catalog:",
        "typescript-eslint": "^8.70.1"
    },
    "engines": {
        "node": ">=24 <25",
        "pnpm": ">=10 <11"
    },
    "pnpm": {
        "overrides": {
            "@derivation-tech/viem-kit": "file:./vendor/derivation-tech-viem-kit-85252d4.tgz"
        }
    },
    "packageManager": "pnpm@10.34.5"
}
