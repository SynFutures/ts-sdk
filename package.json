{
    "name": "@synfutures/ts-sdk",
    "private": true,
    "version": "0.0.1",
    "description": "SynFutures TypeScript SDK monorepo",
    "author": "SynFutures",
    "license": "MIT",
    "scripts": {
        "preinstall": "node scripts/ensure-pnpm.cjs",
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "deps": "pnpm -r i",
        "init": "./scripts/init.sh",
        "prepare": "husky",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "clean": "pnpm -r clean",
        "release": "changeset publish",
        "release:dry": "changeset status",
        "format:check": "prettier --check .",
        "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts --no-frozen-lockfile",
        "test:release": "node --test scripts/tests/*.test.cjs"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "17.12.0",
        "husky": "^9.1.6",
        "lint-staged": "^17.5.1",
        "prettier": "3.9.9",
        "typescript": "catalog:",
        "typescript-eslint": "^8.70.1"
    },
    "engines": {
        "node": ">=24 <25",
        "pnpm": ">=12 <13"
    },
    "packageManager": "pnpm@12.6.0"
}
