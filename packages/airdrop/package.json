{
    "name": "@synfutures/airdrop",
    "version": "0.0.86",
    "description": "SynFutures V3 airdrop plugin",
    "author": "SynFutures",
    "license": "MIT",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build",
        "src",
        "legacy-plugin-host.d.ts",
        "legacy-host-types"
    ],
    "scripts": {
        "build": "node ../../scripts/stage-plugin-host.cjs && tsc -p tsconfig.json",
        "test": "node --test test/*.test.cjs",
        "prepack": "npm run build",
        "gen": "typechain --always-generate-overloads --discriminate-types --target ethers-v5 --out-dir ./src/typechain ./src/abis/*.json && node ../../scripts/link-plugin-bindings.cjs"
    },
    "dependencies": {
        "@ethersproject/abi": "^5.8.0",
        "@ethersproject/abstract-provider": "^5.8.0",
        "@ethersproject/abstract-signer": "^5.8.0",
        "@ethersproject/address": "^5.8.0",
        "@ethersproject/bignumber": "^5.8.0",
        "@ethersproject/bytes": "^5.8.0",
        "@ethersproject/contracts": "^5.8.0",
        "@ethersproject/units": "^5.8.0",
        "@types/node": "^22.19.0",
        "bignumber.js": "^9.3.1",
        "chalk": "^4.1.2",
        "moment": "^2.30.1"
    },
    "devDependencies": {
        "@derivation-tech/web3-core": "1.0.44",
        "@ethersproject/providers": "^5.8.0",
        "@typechain/ethers-v5": "^11.1.0",
        "ethers": "^5.8.0",
        "typechain": "^8.1.0",
        "typescript": "5.6.3"
    },
    "nx": {
        "targets": {
            "build": {
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/scripts/legacy-plugin-host.d.ts",
                    "{workspaceRoot}/scripts/stage-plugin-host.cjs",
                    "{workspaceRoot}/scripts/legacy-host-types/**/*",
                    "{workspaceRoot}/scripts/stage-core-types.cjs",
                    "{workspaceRoot}/scripts/legacy-core-peer.cjs",
                    "{workspaceRoot}/scripts/legacy-event-types.d.ts",
                    "{workspaceRoot}/scripts/legacy-parser-utils.cjs",
                    "{workspaceRoot}/scripts/stage-v5-types.cjs"
                ],
                "outputs": [
                    "{projectRoot}/build",
                    "{projectRoot}/legacy-plugin-host.d.ts",
                    "{projectRoot}/legacy-host-types"
                ]
            },
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    },
    "peerDependencies": {
        "@derivation-tech/web3-core": "^1.0.30"
    },
    "peerDependenciesMeta": {
        "@derivation-tech/web3-core": {
            "optional": true
        }
    }
}
