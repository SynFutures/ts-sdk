{
    "name": "@synfutures/airdrop",
    "version": "0.0.86",
    "description": "SynFutures V3 airdrop plugin",
    "author": "SynFutures",
    "license": "MIT",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build",
        "src",
        "legacy-plugin-host.d.ts",
        "legacy-host-types"
    ],
    "scripts": {
        "build": "node ../../scripts/stage-plugin-host.cjs && tsc -p tsconfig.json",
        "test": "node --test test/*.test.cjs",
        "prepack": "npm run build",
        "gen": "typechain --always-generate-overloads --discriminate-types --target ethers-v5 --out-dir ./src/typechain ./src/abis/*.json"
    },
    "dependencies": {
        "@derivation-tech/web3-core": "^1.0.43",
        "@ethersproject/abi": "^5.8.0",
        "@ethersproject/abstract-provider": "^5.8.0",
        "@ethersproject/providers": "^5.8.0",
        "ethers": "^5.8.0"
    },
    "devDependencies": {
        "@typechain/ethers-v5": "^11.1.0",
        "typechain": "^8.1.0",
        "typescript": "5.6.3"
    },
    "nx": {
        "targets": {
            "build": {
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/scripts/legacy-plugin-host.d.ts",
                    "{workspaceRoot}/scripts/stage-plugin-host.cjs",
                    "{workspaceRoot}/scripts/legacy-host-types/**/*"
                ],
                "outputs": [
                    "{projectRoot}/build",
                    "{projectRoot}/legacy-plugin-host.d.ts",
                    "{projectRoot}/legacy-host-types"
                ]
            },
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    }
}
