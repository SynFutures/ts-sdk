{
    "name": "@synfutures/governance-sdk",
    "version": "0.0.6",
    "description": "SynFutures governance, airdrop and staking clients for ethers v5",
    "license": "MIT",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "files": [
        "build",
        "tge",
        "README.md"
    ],
    "scripts": {
        "build": "node scripts/stage-legacy.cjs && tsc -p tsconfig.json",
        "test": "node --test test/*.test.cjs",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@ethersproject/abi": "^5.8.0",
        "@ethersproject/abstract-provider": "^5.8.0",
        "@ethersproject/abstract-signer": "^5.8.0",
        "@ethersproject/providers": "^5.8.0",
        "@ethersproject/transactions": "^5.8.0",
        "async-retry": "^1.3.3",
        "axios": "^0.35.0",
        "bignumber.js": "^9.3.1",
        "chalk": "^4.1.2",
        "dotenv": "^14.3.2",
        "ethers": "^5.8.0",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "node-cache": "^5.1.2",
        "node-fetch": "^2.7.0",
        "tslib": "^2.6.0"
    },
    "devDependencies": {
        "@derivation-tech/web3-core": "1.0.30",
        "esbuild": "0.28.2",
        "governance-sdk-legacy": "npm:@synfutures/governance-sdk@0.0.5",
        "typescript": "^5.9.3"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/build",
                    "{projectRoot}/tge"
                ]
            },
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    },
    "peerDependencies": {
        "@derivation-tech/web3-core": "^1.0.30"
    },
    "peerDependenciesMeta": {
        "@derivation-tech/web3-core": {
            "optional": true
        }
    }
}
