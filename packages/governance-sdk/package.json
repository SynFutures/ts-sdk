{
    "name": "@synfutures/governance-sdk",
    "version": "0.0.6",
    "license": "MIT",
    "description": "Viem clients for SynFutures governance and TGE",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./tge": {
            "import": {
                "types": "./dist/tge.d.mts",
                "default": "./dist/tge.mjs"
            },
            "require": {
                "types": "./dist/tge.d.cts",
                "default": "./dist/tge.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsc --noEmit && tsdown --config ../../scripts/governance.build.mts",
        "test": "node --test test/*.test.cjs",
        "prepack": "npm run build"
    },
    "dependencies": {
        "viem": "catalog:"
    },
    "devDependencies": {
        "typescript": "catalog:"
    }
}
