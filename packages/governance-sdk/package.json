{
    "name": "@synfutures/governance-sdk",
    "version": "0.0.5",
    "description": "SynFutures governance, airdrop and staking clients for ethers v5",
    "license": "MIT",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "files": [
        "build",
        "tge",
        "README.md"
    ],
    "scripts": {
        "build": "node scripts/stage-legacy.cjs && tsc -p tsconfig.json",
        "test": "node --test test/*.test.cjs",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@derivation-tech/web3-core": "1.0.30",
        "@ethersproject/abi": "^5.7.0",
        "@ethersproject/abstract-provider": "^5.7.0",
        "@ethersproject/providers": "^5.7.0",
        "ethers": "^5.7.2",
        "lodash": "^4.17.21",
        "tslib": "^2.6.0"
    },
    "devDependencies": {
        "governance-sdk-legacy": "npm:@synfutures/governance-sdk@0.0.5",
        "typescript": "^5.9.3"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/build",
                    "{projectRoot}/tge"
                ]
            },
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    }
}
