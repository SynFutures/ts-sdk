{
    "name": "@synfutures/oyster-governance-data-source",
    "version": "0.0.84",
    "description": "SynFutures V3 governance subgraph plugin",
    "author": "SynFutures",
    "license": "MIT",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build",
        "src",
        "legacy-plugin-host.d.ts",
        "legacy-host-types"
    ],
    "scripts": {
        "build": "node ../../scripts/stage-plugin-host.cjs && tsc -p tsconfig.json",
        "test": "node --test test/*.test.cjs",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@ethersproject/bignumber": "^5.8.0",
        "@types/lodash": "^4.17.0",
        "@types/node": "^22.19.0",
        "async-retry": "^1.3.3",
        "bignumber.js": "^9.3.1",
        "chalk": "^4.1.2",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "node-fetch": "^2.7.0"
    },
    "devDependencies": {
        "@derivation-tech/web3-core": "1.0.44",
        "ethers": "^5.8.0",
        "typescript": "^5.9.3"
    },
    "nx": {
        "targets": {
            "build": {
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/scripts/legacy-plugin-host.d.ts",
                    "{workspaceRoot}/scripts/stage-plugin-host.cjs",
                    "{workspaceRoot}/scripts/legacy-host-types/**/*",
                    "{workspaceRoot}/scripts/stage-core-types.cjs",
                    "{workspaceRoot}/scripts/legacy-core-peer.cjs",
                    "{workspaceRoot}/scripts/legacy-event-types.d.ts",
                    "{workspaceRoot}/scripts/legacy-parser-utils.cjs",
                    "{workspaceRoot}/scripts/stage-v5-types.cjs"
                ],
                "outputs": [
                    "{projectRoot}/build",
                    "{projectRoot}/legacy-plugin-host.d.ts",
                    "{projectRoot}/legacy-host-types"
                ]
            },
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    },
    "peerDependencies": {
        "@derivation-tech/web3-core": "^1.0.30"
    },
    "peerDependenciesMeta": {
        "@derivation-tech/web3-core": {
            "optional": true
        }
    }
}
