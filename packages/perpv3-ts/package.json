{
    "name": "@synfutures/perpv3-ts",
    "version": "0.2.8",
    "description": "TypeScript SDK for SynFutures V3 Perpetual Contracts",
    "author": "SynFutures",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.mjs"
        },
        "./types": {
            "import": {
                "types": "./dist/types.d.ts",
                "default": "./dist/types.mjs"
            },
            "require": {
                "types": "./dist/types.d.cts",
                "default": "./dist/types.cjs"
            },
            "default": "./dist/types.mjs"
        },
        "./actions": {
            "import": {
                "types": "./dist/actions.d.ts",
                "default": "./dist/actions.mjs"
            },
            "require": {
                "types": "./dist/actions.d.cts",
                "default": "./dist/actions.cjs"
            },
            "default": "./dist/actions.mjs"
        },
        "./queries": {
            "import": {
                "types": "./dist/queries.d.ts",
                "default": "./dist/queries.mjs"
            },
            "require": {
                "types": "./dist/queries.d.cts",
                "default": "./dist/queries.cjs"
            },
            "default": "./dist/queries.mjs"
        },
        "./apis": {
            "import": {
                "types": "./dist/apis.d.ts",
                "default": "./dist/apis.mjs"
            },
            "require": {
                "types": "./dist/apis.d.cts",
                "default": "./dist/apis.cjs"
            },
            "default": "./dist/apis.mjs"
        },
        "./abis": {
            "import": {
                "types": "./dist/abis.d.ts",
                "default": "./dist/abis.mjs"
            },
            "require": {
                "types": "./dist/abis.d.cts",
                "default": "./dist/abis.cjs"
            },
            "default": "./dist/abis.mjs"
        },
        "./parsers": {
            "import": {
                "types": "./dist/parsers.d.ts",
                "default": "./dist/parsers.mjs"
            },
            "require": {
                "types": "./dist/parsers.d.cts",
                "default": "./dist/parsers.cjs"
            },
            "default": "./dist/parsers.mjs"
        },
        "./frontend": {
            "import": {
                "types": "./dist/frontend.d.ts",
                "default": "./dist/frontend.mjs"
            },
            "require": {
                "types": "./dist/frontend.d.cts",
                "default": "./dist/frontend.cjs"
            },
            "default": "./dist/frontend.mjs"
        },
        "./utils": {
            "import": {
                "types": "./dist/utils.d.ts",
                "default": "./dist/utils.mjs"
            },
            "require": {
                "types": "./dist/utils.d.cts",
                "default": "./dist/utils.cjs"
            },
            "default": "./dist/utils.mjs"
        },
        "./math": {
            "import": {
                "types": "./dist/math.d.ts",
                "default": "./dist/math.mjs"
            },
            "require": {
                "types": "./dist/math.d.cts",
                "default": "./dist/math.cjs"
            },
            "default": "./dist/math.mjs"
        },
        "./constants": {
            "import": {
                "types": "./dist/constants.d.ts",
                "default": "./dist/constants.mjs"
            },
            "require": {
                "types": "./dist/constants.d.cts",
                "default": "./dist/constants.cjs"
            },
            "default": "./dist/constants.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.{cjs,mjs}",
        "dist/**/*.d.ts",
        "dist/**/*.d.cts",
        "dist/**/*.d.ts.map",
        "dist/**/*.map",
        "!dist/**/*.test.*",
        "README.md",
        "MIGRATION.md",
        "docs/**/*.md"
    ],
    "scripts": {
        "build": "tsup",
        "build:check": "tsc --noEmit",
        "typecheck:public": "tsc --noEmit -p tsconfig.typecheck.json",
        "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
        "verify": "pnpm run lint && pnpm run build:check && pnpm run typecheck:public && pnpm run typecheck:examples && pnpm exec jest --runInBand && pnpm run build && pnpm run verify:consumer",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "prepack": "npm run build && npm run build:check",
        "lint": "eslint",
        "format": "prettier --write \"{src,examples,typecheck,scripts}/**/*.{ts,js,mjs,cjs,json,md}\" \"*.{ts,js,mjs,cjs,json,md}\" \"docs/**/*.md\"",
        "test:unit": "jest",
        "test:devnet": "jest --config jest.devnet.config.js",
        "test": "pnpm run test:unit && pnpm run test:devnet",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "demo": "tsx examples/index.ts",
        "devnet:check": "node scripts/devnet/check.js",
        "devnet:regen": "tsx scripts/devnet/regen.ts",
        "verify:consumer": "node scripts/verify-consumer.mjs",
        "prepublishOnly": "node scripts/check-release-dependency.mjs"
    },
    "keywords": [
        "synfutures",
        "perpetual",
        "defi",
        "typescript",
        "sdk"
    ],
    "dependencies": {
        "@derivation-tech/viem-kit": "catalog:",
        "@noble/curves": "^1.9.1",
        "axios": "^1.12.2",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "viem": "catalog:"
    },
    "peerDependencies": {
        "ws": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "ws": {
            "optional": true
        }
    },
    "devDependencies": {
        "@foundry-rs/anvil": "1.5.1",
        "@jest/globals": "^30.2.0",
        "@synfutures/v3-contracts": "^0.0.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.0.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.0.0",
        "jest": "^30.2.0",
        "prettier": "^3.0.0",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
