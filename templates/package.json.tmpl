{
    "name": "@synfutures/{PACKAGE}",
    "version": "0.0.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\"",
        "lint": "eslint src test",
        "lint:fix": "eslint src test --fix",
        "test": "jest",
        "test:coverage": "jest --coverage=true --coverage-reporters=text",
        "test:ci": "jest --coverage=true --coverage-reporters=json --verbose",
        "test:watch": "pnpm run test --watch",
        "build": "tsc -p tsconfig.build.json",
        "build:check": "tsc --noEmit -p tsconfig.build.json",
        "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\""
    },
    "dependencies": {},
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.12"
    },
    "jest": {
        "verbose": true,
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "./",
        "testEnvironment": "node",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "tsconfig": "tsconfig.test.json"
                }
            ]
        },
        "testTimeout": 30000
    }
}
