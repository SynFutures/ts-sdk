{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declarationDir": "./dist",
        "module": "NodeNext",
        "declaration": true,
        "declarationMap": true,
        "noEmitOnError": true,
        "sourceMap": true,
        "moduleResolution": "NodeNext"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json"
    ],
    "exclude": [
        "node_modules",
        "scripts",
        "dist"
    ]
}
