{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "baseUrl": "./",
        "rootDir": "./src",
        "outDir": "./dist",
        "declarationDir": "./dist",
        "module": "CommonJS",
        "declaration": true,
        "declarationMap": true,
        "noEmitOnError": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json",
        "types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "scripts",
        "dist"
    ]
}
